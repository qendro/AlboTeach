<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Small steps toward everyday Kosovo Albanian. A private learning space for your family."
    />
    <meta name="theme-color" content="#183e36" />
    <.live_title default="AlboTeach" suffix=" · Learn a little, connect a lot">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/print.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body><a href="#main-content" class="skip-link">Skip to content</a>{@inner_content}</body>
</html>
